{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": ["**/*.ts", ".omp/**/*.ts"],
  "exclude": ["node_modules", "**/node_modules", ".claude/worktrees"]
}
