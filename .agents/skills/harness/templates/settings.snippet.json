{
  "_comment": "The eight platform prerequisites \u2014 seven hooks plus CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH. ALL EIGHT are required and EACH degrades SILENTLY if absent \u2014 none of them errors. bin/merge-settings.py merges exactly this into a project's .claude/settings.json without disturbing entries the project already has. Do not hand-merge; that is how one of the seven goes missing. check-domain.sh appears TWICE, on two events: PreToolUse BLOCKS a bad write it can measure, PostToolUse --post REPORTS one it could not (issue #132 \u2014 Edit carries no whole-file content, Bash carries no path, and the main session is exempt from the domain phase that used to gate both).",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "3"
  },
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "harness-.*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agents/skills/harness/bin/inject-expertise.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agents/skills/harness/bin/check-domain.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agents/skills/harness/bin/branch-create-gate.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agents/skills/harness/bin/bash-write-guard.sh"
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agents/skills/harness/bin/dispatch-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agents/skills/harness/bin/check-domain.sh --post"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "harness-.*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agents/skills/harness/bin/validate-digest.py --hook"
          }
        ]
      }
    ]
  }
}
