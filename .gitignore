# OS
.DS_Store

# Harness run state — ephemeral scratch, pruned on log_retention_days.
# Without this rule, run dirs dirty the working tree and the dirty-tree halt
# (SPEC 8.6) deadlocks the next crew on the harness's own artifacts.
.harness/features/*/runs/**

# The one-session PyYAML bootstrap marker (DEC-171 am.1). The write hooks fail CLOSED
# when PyYAML is absent, so the first session gets one escape and drops this marker to
# record that it was used. Untracked it dirties the tree, and a dirty tree halts the
# next team run on the rule directly above — the deadlock this rule prevents.
.harness/.pyyaml-bootstrap

# Local-only settings; the committed .claude/settings.json carries the
# platform prerequisites that must travel with the repo.
.claude/settings.local.json

# Worktrees live inside .claude/ in some projects and must never be committed
# or scanned as source (they duplicate every file).
.claude/worktrees/

# harness: compiled bytecode and merge-settings backups are never committed
__pycache__/
*.pyc
.claude/settings.json.harness-bak
