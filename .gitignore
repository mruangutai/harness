# OS
.DS_Store

# Harness run state — ephemeral scratch, pruned on log_retention_days.
# Without this rule, run dirs dirty the working tree and the dirty-tree halt
# (SPEC 8.6) deadlocks the next crew on the harness's own artifacts.
.harness/*/features/*/runs/**
# FEAT-1821: the ui lane's evidence (results.json + WebP) under runs/<id>/ui/ is committed,
# never scratch — a run directory is re-included only so its ui/ child can be.
!.harness/*/features/*/runs/*/
.harness/*/features/*/runs/*/**
!.harness/*/features/*/runs/*/ui/
!.harness/*/features/*/runs/*/ui/**
# Inside a run's ui/, only reporter-published evidence is tracked: results.json, evidence/ WebPs
# and traces/ ZIPs the Checks `### Traces` table lists. Runner scratch under ui/ stays ignored.
.harness/*/features/*/runs/*/ui/test-results/
.harness/*/features/*/runs/*/ui/playwright-report/

# The one-session PyYAML bootstrap marker (DEC-171). The write hooks fail CLOSED
# when PyYAML is absent, so the first session gets one escape and drops this marker to
# record that it was used. Untracked it dirties the tree, and a dirty tree halts the
# next team run on the rule directly above — the deadlock this rule prevents.
.harness/.pyyaml-bootstrap

# Local-only settings; the committed .claude/settings.json carries the
# platform prerequisites that must travel with the repo.
.claude/settings.local.json

# Worktrees live inside .claude/ in some projects and must never be committed
# or scanned as source (they duplicate every file).
.claude/worktrees/

# harness: compiled bytecode and merge-settings backups are never committed
__pycache__/
*.pyc
.claude/settings.json.harness-bak

# harness: the post-sweep high-water mark (mtime only, never content)
.harness/.shape-sweep-stamp

# gh cost log — opt-in via HARNESS_GH_COST_LOG=1 (FEAT-29). THIS EXACT GLOB, never all of
# .harness/logs/ — the session journals there are TRACKED and a blanket rule would untrack them.
# It carries gh argv, which can hold issue titles and body text.
.harness/logs/gh-cost-*.jsonl

# harness: the single-flight claim registry (issue #551) is per-checkout transient state
# written by hook processes. Untracked it dirties the working tree, and a dirty tree halts the
# next team run on the rule for run state directly above it. Same reason as
# .harness/.pyyaml-bootstrap and .harness/.shape-sweep-stamp; the naming follows those two.
.harness/.inflight-claims.json

# harness: merge locks (FEAT-32). harness_merge.locked_update takes `<path>.lock` beside every
# file it guards — the plan, the per-agent observation log, both expertise tiers, and the claim
# registry. All four live under .harness/, so this covers exactly them. A COMMITTED lock is
# worse than none: it never expires and wedges the next write on a fresh checkout.
.harness/**/*.lock

# --- harness ---
# Run dirs are ephemeral; a dirty tree halts a team with BLOCKED, so these
# must be ignored or the harness deadlocks itself. Everything else under
# .harness/ is committed on purpose — it is the record of what shipped.
.harness/features/*/runs/**
.claude/skills/harness/bin/dashboard/client/node_modules/
.claude/skills/harness/bin/dashboard/client/.vite/
# FEAT-1821: Playwright lane scratch stays local; runs/<id>/ui/results.json and WebPs are evidence and are committed
.claude/skills/harness/bin/dashboard/client/playwright-report/
.claude/skills/harness/bin/dashboard/client/test-results/
.claude/skills/harness/bin/dashboard/client/blob-report/
# --- end harness ---
