{
  "_template": "Canonical harness.json. harness-init instantiates this as the control plane's own .harness/harness.json. harness-add-repo instantiates a fleet member's own .harness/harness.json which must be committed to that repository's default branch - factory_config.product_config reads it from the remote there, with no disk fallback. dev-ops fills every test_kinds.cmd by RUNNING it. See templates/README.md.",
  "schema_version": 3,
  "panel_era_start": null,
  "seam_era_start": null,
  "decision_dispositions_era_start": null,
  "test_matrix": {
    "logic": {
      "always": [
        "unit"
      ]
    },
    "api": {
      "always": [
        "unit",
        "functional"
      ],
      "when": [
        {
          "kind": "integration",
          "if": "touches_db_or_external"
        }
      ]
    },
    "cross_module": {
      "always": [
        "unit",
        "functional",
        "integration"
      ]
    },
    "frontend": {
      "always": [
        "unit",
        "component"
      ],
      "when": [
        {
          "kind": "ui",
          "if": "has_interaction_flow"
        }
      ]
    },
    "feature": {
      "always": [
        "unit",
        "functional",
        "integration"
      ],
      "when": [
        {
          "kind": "ui",
          "if": "has_interaction_flow"
        }
      ]
    },
    "bugfix": {
      "always": [],
      "when": [
        {
          "kind": "unit",
          "if": "touches_runtime_code"
        },
        {
          "kind": "integration",
          "if": "fix_confined_to_tests_and_contract_docs"
        },
        {
          "kind": "__bug_class__",
          "if": "match_bug_class"
        }
      ]
    },
    "ai_behavior": {
      "always": [
        "eval"
      ]
    },
    "config": {
      "always": [],
      "when": [
        {
          "kind": "integration",
          "if": "touches_config_shape"
        }
      ]
    },
    "scaffolding": {
      "always": []
    },
    "docs": {
      "always": []
    }
  },
  "test_kinds": {
    "unit": {
      "detect": "tests/unit/**|**/*.test.*|**/*_test.*|**/test_*.py",
      "exclude": ".claude/worktrees/**|node_modules/**|vendor/**|.venv/**|dist/**|build/**",
      "cmd": null,
      "status": "unresolved",
      "_reason": "unset \u2014 dev-ops has not run detection yet"
    },
    "functional": {
      "detect": "tests/functional/**",
      "exclude": ".claude/worktrees/**|node_modules/**|vendor/**|.venv/**",
      "cmd": null,
      "status": "unresolved",
      "_reason": "unset \u2014 dev-ops has not run detection yet"
    },
    "integration": {
      "detect": "tests/integration/**",
      "exclude": ".claude/worktrees/**|node_modules/**|vendor/**|.venv/**",
      "cmd": null,
      "status": "unresolved",
      "_reason": "unset \u2014 dev-ops has not run detection yet"
    },
    "component": {
      "detect": "**/*.spec.tsx|**/*.stories.tsx|**/*.stories.ts",
      "exclude": ".claude/worktrees/**|node_modules/**|dist/**|build/**",
      "cmd": null,
      "status": "unresolved",
      "_reason": "unset \u2014 dev-ops has not run detection yet"
    },
    "ui": {
      "detect": "tests/e2e/**|e2e/**|**/*.e2e.spec.ts",
      "exclude": ".claude/worktrees/**|node_modules/**",
      "cmd": null,
      "status": "unresolved",
      "_reason": "unset \u2014 dev-ops has not run detection yet. If the project has no browser-driver, set status excluded with excluded_because and a signed DEC: a null cmd on a required ui kind is misconfigured, and qa returns BLOCKED."
    },
    "eval": {
      "detect": "evals/**|tests/**eval**",
      "exclude": ".claude/worktrees/**|node_modules/**|.venv/**",
      "cmd": null,
      "status": "unresolved",
      "_reason": "unset \u2014 dev-ops has not run detection yet. Required only for change_type: ai_behavior; ai-dev authors the eval, qa gates it."
    },
    "typecheck": {
      "detect": "**/*.ts|**/*.tsx",
      "exclude": ".claude/worktrees/**|node_modules/**|dist/**|build/**",
      "cmd": null,
      "status": "unresolved",
      "_reason": "unset \u2014 dev-ops has not run detection yet. Not in the matrix; available for qa to add.",
      "classifies_tests": false
    }
  },
  "commit_attribution": {
    "agent_prefix": "[harness:<step-id>]",
    "human_prefix": "[harness:human]"
  },
  "dirty_tree_whitelist": [
    ".harness/**",
    ".claude/worktrees/**"
  ],
  "log_retention_days": 30,
  "budgets": {
    "max_total_cycles": 10,
    "max_total_runs": 20,
    "orchestrator_context_warn_tokens": 200000,
    "plan_phase_warn_minutes": 90,
    "rework_round_minutes": 45,
    "preload_warn_words": {"universal": 1900, "agent": 5500}
  },
  "gates": {
    "review": "advisory_unless_high"
  },
  "github": {
    "sync": false,
    "repo": null,
    "board": null
  }
}
