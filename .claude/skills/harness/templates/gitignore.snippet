# --- harness ---
# A feature's notes/ (prototypes, mockups and screenshots included), runs/ and observations/,
# and project notes under .harness/notes/, are local working files kept only for distill and
# expertise and never committed (DEC-260).
.harness/*/features/*/notes/
.harness/*/features/*/runs/
.harness/*/features/*/observations/
.harness/notes/
# Merge locks beside the harness's records; a committed lock would be shared state.
.harness/**/*.lock
# The one-session PyYAML bootstrap marker (DEC-171). Written by the write hooks
# when PyYAML is missing, so the FIRST session can still recover; it is per-session
# machine state, never a record.
.harness/.pyyaml-bootstrap
__pycache__/
*.pyc
.claude/worktrees/
.DS_Store
# --- end harness ---
