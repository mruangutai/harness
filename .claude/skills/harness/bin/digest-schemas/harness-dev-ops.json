{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.invalid/digest-schemas/harness-dev-ops.json",
  "title": "harness-dev-ops digest return",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "VERDICT",
    "DIGEST",
    "artifact"
  ],
  "properties": {
    "VERDICT": {
      "$ref": "common.json#/$defs/verdict"
    },
    "DIGEST": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "open_questions",
        "files_touched",
        "expertise_update",
        "change_type",
        "applied",
        "suite",
        "task",
        "task_verify",
        "test_kinds_written"
      ],
      "properties": {
        "headline": {
          "$ref": "common.json#/$defs/text"
        },
        "open_questions": {
          "$ref": "common.json#/$defs/open_questions"
        },
        "files_touched": {
          "$ref": "common.json#/$defs/string_list"
        },
        "expertise_update": {
          "$ref": "common.json#/$defs/expertise_update"
        },
        "change_type": {
          "enum": [
            "config",
            "scaffolding",
            "infra",
            "ci"
          ]
        },
        "applied": {
          "$ref": "common.json#/$defs/string_list"
        },
        "suite": {
          "$ref": "common.json#/$defs/pass_fail_nullable"
        },
        "task": {
          "$ref": "common.json#/$defs/task_id"
        },
        "task_verify": {
          "$ref": "common.json#/$defs/pass_fail_nullable"
        },
        "test_kinds_written": {
          "$ref": "common.json#/$defs/string_list"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "task": {
                "const": "none"
              }
            },
            "required": [
              "task"
            ]
          },
          "then": {
            "properties": {
              "task_verify": {
                "$ref": "common.json#/$defs/unset"
              }
            }
          }
        }
      ]
    },
    "artifact": {
      "$ref": "common.json#/$defs/artifact"
    }
  }
}
