{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.invalid/digest-schemas/harness-documentor.json",
  "title": "harness-documentor digest return",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "VERDICT",
    "DIGEST",
    "artifact"
  ],
  "properties": {
    "VERDICT": {
      "$ref": "common.json#/$defs/verdict"
    },
    "DIGEST": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "open_questions",
        "files_touched",
        "expertise_update",
        "docs_updated",
        "gaps"
      ],
      "properties": {
        "headline": {
          "$ref": "common.json#/$defs/text"
        },
        "open_questions": {
          "$ref": "common.json#/$defs/list"
        },
        "files_touched": {
          "$ref": "common.json#/$defs/list"
        },
        "expertise_update": {
          "$ref": "common.json#/$defs/list"
        },
        "docs_updated": {
          "$ref": "common.json#/$defs/list"
        },
        "gaps": {
          "$ref": "common.json#/$defs/list"
        },
        "stale_found": {
          "$ref": "common.json#/$defs/list"
        }
      }
    },
    "artifact": {
      "$ref": "common.json#/$defs/artifact"
    }
  }
}
