{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.invalid/digest-schemas/harness-security-reviewer.json",
  "title": "harness-security-reviewer digest return",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "VERDICT",
    "DIGEST",
    "artifact"
  ],
  "properties": {
    "VERDICT": {
      "$ref": "common.json#/$defs/verdict"
    },
    "DIGEST": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "open_questions",
        "files_touched",
        "expertise_update",
        "severity_max",
        "findings",
        "must_fix"
      ],
      "properties": {
        "headline": {
          "$ref": "common.json#/$defs/text"
        },
        "open_questions": {
          "$ref": "common.json#/$defs/list"
        },
        "files_touched": {
          "$ref": "common.json#/$defs/list"
        },
        "expertise_update": {
          "$ref": "common.json#/$defs/list"
        },
        "severity_max": {
          "$ref": "common.json#/$defs/severity_nullable"
        },
        "findings": {
          "$ref": "common.json#/$defs/findings"
        },
        "must_fix": {
          "$ref": "common.json#/$defs/list"
        },
        "in_scope": {
          "$ref": "common.json#/$defs/boolean"
        },
        "scope_reason": {
          "$ref": "common.json#/$defs/text"
        },
        "threat_model": {
          "$ref": "common.json#/$defs/list"
        }
      }
    },
    "artifact": {
      "$ref": "common.json#/$defs/artifact"
    }
  }
}
