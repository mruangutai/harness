{
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "3"
  },
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "harness-.*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/skills/harness/bin/inject-expertise.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/skills/harness/bin/check-domain.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/skills/harness/bin/branch-create-gate.py"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/skills/harness/bin/bash-write-guard.py"
          },
        {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/skills/harness/bin/gh-close-gate.sh"
          },
        {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/skills/harness/bin/plan-sign-gate.py"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/skills/harness/bin/merge-gate.py"
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/skills/harness/bin/dispatch-guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/skills/harness/bin/check-domain.py --post"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "harness-.*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/skills/harness/bin/validate-digest.py --hook"
          }
        ]
      }
    ]
  }
}
