      "signed": "DEC-217"
    }
  },
  "test_kinds": {
    "unit": {
      "detect": "tests/unit/**|**/*.test.*|**/*_test.*|**/test_*.py",
      "exclude": ".claude/worktrees/**|node_modules/**|vendor/**|.venv/**|dist/**|build/**",
      "cmd": ".agents/skills/harness/bin/run-unit-tests.py --kind unit",
      "status": "active"
    },
    "functional": {
      "detect": "tests/functional/**",
      "exclude": ".claude/worktrees/**|node_modules/**|vendor/**|.venv/**",
      "cmd": null,
      "status": "excluded",
      "excluded_because": "this repository ships no service API, and run-unit-tests.py splits its suite by the tests/unit and tests/integration directories. There is no third bucket; pointing functional at either would double-count files the other kind already runs.",
      "signed": "DEC-187"
    },
    "omp_session_accessor": {
      "detect": "tests/manual/probe-omp-session-accessor.py",
      "exclude": ".claude/worktrees/**",
      "cmd": "tests/manual/probe-omp-session-accessor.py",
      "status": "locally_run",
      "runner_note": "requires the omp binary on PATH and live anthropic/claude-sonnet-5 credentials (issue #1187); tests.yml carries no secrets.*, so this can never run in CI. Run on a credentialled host before a ship decision that touches inflight_registry.py's session-file resolution, and record the result under the feature's notes/ directory."
    },
    "handoff_comprehension": {
      "detect": "tests/manual/probe-handoff-comprehension.py",
      "exclude": ".claude/worktrees/**",
      "cmd": "tests/manual/probe-handoff-comprehension.py",
      "status": "locally_run",
      "runner_note": "requires the omp binary on PATH and live model credentials; this can never run in CI. Run on a credentialled host before a ship decision that changes the handoff contract, and record the result under the feature's notes/ directory."
    },
    "issue_types_live": {
      "detect": "tests/manual/probe-issue-types.py",
      "exclude": ".claude/worktrees/**",
      "cmd": "tests/manual/probe-issue-types.py",
      "status": "locally_run",
      "runner_note": "requires gh authenticated against the pinned github.repo to read that repository's native Issue Types; it creates nothing and can never run in CI, so run it on a credentialled host before a ship decision that touches the issue-type path and record the verdict under the feature's notes/ directory."
    },
    "integration": {
      "detect": "tests/integration/**",
      "exclude": ".claude/worktrees/**|node_modules/**|vendor/**|.venv/**",
      "cmd": ".agents/skills/harness/bin/run-unit-tests.py --kind integration",
      "status": "active"
    },
    "component": {
      "detect": "**/*.spec.tsx|**/*.stories.tsx|**/*.stories.ts",
      "exclude": ".claude/worktrees/**|node_modules/**|dist/**|build/**",
      "cmd": null,
      "_reason": "unset \u2014 dev-ops has not run detection yet",
      "status": "unresolved"
    },
    "ui": {
      "detect": "tests/e2e/**|e2e/**|**/*.e2e.spec.ts",
      "exclude": ".claude/worktrees/**|node_modules/**",
      "cmd": null,
      "_reason": "unset \u2014 dev-ops has not run detection yet. If the project has no browser-driver, leave null: qa records `ui: skipped (no browser target)` and does NOT fail.",
      "status": "unresolved"
    },
    "eval": {
      "detect": "evals/**|tests/**eval**",
      "exclude": ".claude/worktrees/**|node_modules/**|.venv/**",
      "cmd": null,
      "status": "excluded",
      "excluded_because": "detection HAS run and found no evals/ tree: this repository's ai_behavior surface is the two probe scripts already registered as their own locally_run kinds, handoff_comprehension and omp_session_accessor, and those probes ARE the evals DEC-70 requires ai-dev to author and qa to gate. Pointing eval at them would double-count files another kind already runs, which is the same rationale DEC-187 signed for functional. The prior record read 'dev-ops has not run detection yet' with status unresolved, which DEC-187 does not permit for a kind the matrix names and which read as absent coverage rather than covered-elsewhere.",
      "signed": "DEC-187"
    },
    "typecheck": {
      "detect": "**/*.ts|**/*.tsx",
      "exclude": ".claude/worktrees/**|node_modules/**|dist/**|build/**",
      "cmd": "bun run typecheck",
      "status": "active",
      "classifies_tests": false
    }
  },
  "commit_attribution": {
    "agent_prefix": "[harness:<step-id>]",
    "human_prefix": "[harness:human]"
  },
  "dirty_tree_whitelist": [
    ".harness/**",
    ".claude/worktrees/**"
  ],
  "log_retention_days": 30,
  "budgets": {
    "max_total_cycles": 10,
    "max_total_runs": 20,
    "orchestrator_context_warn_tokens": 200000,
    "plan_phase_warn_minutes": 90,
    "rework_round_minutes": 45,
    "preload_warn_words": {"universal": 1900, "agent": 5500}
  },
  "gates": {
    "review": "advisory_unless_high"
  },
  "github": {
    "sync": true,
    "repo": "mruangutai/harness",
    "board": {
      "owner": "mruangutai",
      "number": 3,
      "station_field": "Status",
      "stations": ["backlog", "plan", "ready", "building", "review", "done"]
    }
  }
}
