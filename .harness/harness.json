{
  "schema_version": 3,
  "panel_era_start": "2026-08-31",
  "seam_era_start": "2026-09-17",
  "decision_dispositions_era_start": "2026-11-22T01:58:29Z",
  "test_matrix": {
    "logic": {
      "always": [
        "unit"
      ]
    },
    "api": {
      "always": [
        "unit"
      ],
      "when": [
        {
          "kind": "integration",
          "if": "touches_db_or_external"
        }
      ]
    },
    "cross_module": {
      "always": [
        "unit",
        "integration"
      ]
    },
    "frontend": {
      "always": [
        "unit",
        "component"
      ],
      "when": [
        {
          "kind": "ui",
          "if": "has_interaction_flow"
        }
      ]
    },
    "feature": {
      "always": [
        "unit",
        "integration"
      ],
      "when": [
        {
          "kind": "ui",
          "if": "has_interaction_flow"
        }
      ]
    },
    "bugfix": {
      "always": [],
      "when": [
        {
          "kind": "unit",
          "if": "touches_runtime_code"
        },
        {
          "kind": "integration",
          "if": "fix_confined_to_tests_and_contract_docs"
        },
        {
          "kind": "__bug_class__",
          "if": "match_bug_class"
        }
      ]
    },
    "ai_behavior": {
      "always": [
        "eval"
      ]
    },
    "config": {
      "always": [],
      "when": [
        {
          "kind": "integration",
          "if": "touches_config_shape"
        }
      ]
    },
    "scaffolding": {
      "always": []
    },
    "docs": {
      "always": []
    }
  },
  "_matrix_provenance": {
    "api": {
      "removed": [
