    },
    "cross_module": {
      "removed": [
        "functional"
      ],
      "added": [],
      "signed": "DEC-187"
    },
    "feature": {
      "removed": [
        "functional"
      ],
      "added": [],
      "signed": "DEC-187"
    },
    "config": {
      "removed": [],
